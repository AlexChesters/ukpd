{
  "name": "ukpd",
  "version": "8.0.0",
  "description": "a node module to provide an interface to the UK police data API",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build/"
  ],
  "engines": {
    "node": "^22 || ^24",
    "npm": "^10"
  },
  "scripts": {
    "watch": "tsc --project tsconfig.json -w",
    "prebuild": "rm -rf build/",
    "build": "tsc --project tsconfig.json",
    "unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js",
    "lint": "eslint src",
    "examples": "sh ci/scripts/run-all-examples.sh",
    "pretest": "npm run build",
    "test": "npm run unit && npm run lint && npm run examples",
    "preversion": "npm test && npm run build",
    "postversion": "git push --follow-tags && npm publish"
  },
  "repository": {
    "url": "git+https://github.com/AlexChesters/ukpd.git",
    "type": "git"
  },
  "author": "Alex Chesters",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlexChesters/ukpd/issues"
  },
  "homepage": "https://github.com/AlexChesters/ukpd#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/jest": "^30.0.0",
    "@types/ramda": "^0.32.0",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jiti": "^2.7.0",
    "ramda": "^0.32.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
